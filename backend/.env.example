# Required
# Local: mongodb://localhost:27017/careplan
# Vercel/Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careplan?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/careplan
PORT=3001

# Optional (Vercel sets VERCEL_URL automatically)
FRONTEND_URL=

# LLM configuration
LLM_PROVIDER=mock        # mock | openai
OPENAI_API_KEY=          # required if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
